# ======================================================
# 游戏时间轴看板 - 环境变量模板
# 本文件提交 Git，不得填写真实密钥 / 密码 / 内网地址
# 线上：cp .env.example .env 后填入真实值
# ======================================================

# 运行环境：local / prod
ENV=local

# 本地 SQLite（相对项目根）
SQLITE_PATH=./data/game_schedule.db

# 线上 MySQL（占位，真实值仅在服务器 .env 填写）
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password-placeholder
MYSQL_DB=game_schedule

# 企业微信机器人
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=PLACEHOLDER

# 管理员权限（示例文件只放占位值，真实密码/密钥仅填写到线上 .env）
ADMIN_PASSWORD=your-admin-password
AUTH_SECRET_KEY=随机默认key
# 管理员登录 token 有效期，默认 7 天：7 * 24 * 60 * 60 = 604800
AUTH_TOKEN_EXPIRE_SECONDS=604800

# 数据保留天数（基于 online_date），设为 0 表示永不删除
DATA_RETENTION_DAYS=60

# 定期清理时间：星期几（mon/tue/wed/thu/fri/sat/sun）+ 几点（0~23）
CLEANUP_DAY=mon
CLEANUP_HOUR=3
